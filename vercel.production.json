{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://novora-backend-56ot.onrender.com/api/:path*"
    },
    {
      "source": "/auth/:path*",
      "destination": "https://novora-backend-56ot.onrender.com/auth/:path*"
    },
    {
      "source": "/((?!api/|auth/).*)",
      "destination": "/index.html"
    }
  ]
}

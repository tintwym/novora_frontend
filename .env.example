# Leave empty in local AND on Vercel when using vercel.json /api rewrites.
# (Empty = same-origin /api → cookies + CSRF work.)
# VITE_API_BASE_URL=

# Vite dev proxy target. Default is the Render production API.
# For a local Spring `local` profile instead:
# VITE_API_PROXY_TARGET=http://127.0.0.1:8081
VITE_API_PROXY_TARGET=https://novora-backend-56ot.onrender.com

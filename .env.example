# Leave empty in local AND on Vercel when using same-origin /api rewrites.
# (Empty = same-origin /api → cookies + CSRF work.)
# NEXT_PUBLIC_API_BASE_URL=

# Local dev only — Next.js rewrites /api → Spring on 8081.
# Production uses vercel.json rewrites to Render (no env var required).
API_PROXY_TARGET=http://127.0.0.1:8081

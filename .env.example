# Leave empty in local AND on Vercel when using same-origin /api rewrites (next.config.ts).
# (Empty = same-origin /api → cookies + CSRF work.)
# NEXT_PUBLIC_API_BASE_URL=

# Next.js dev proxy target — local Spring `local` profile (port 8081).
API_PROXY_TARGET=http://127.0.0.1:8081
# Production Render (disabled while developing locally):
# API_PROXY_TARGET=https://novora-backend-wiem.onrender.com

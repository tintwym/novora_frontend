# Leave empty in local dev — Vite proxies /api → backend (see vite.config.ts).
# For production builds against a remote API, set the full origin:
# VITE_API_BASE_URL=https://your-api.onrender.com

# Optional: override local proxy target (default http://127.0.0.1:8081 for Spring profile `local`)
# VITE_API_PROXY_TARGET=http://127.0.0.1:8081
